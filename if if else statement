}


float commision(float &Total_salse) {
	 
	 

	if (Total_salse == 1000000 ){
	
		return Total_salse * 0.01;
	
	}

	else if (Total_salse >= 500000  ) {

		return Total_salse * 0.02;

	}

	else if (Total_salse >= 100000 ) {

		return Total_salse * 0.03;

	}

	else if (Total_salse >= 50000  ) {

		return Total_salse * 0.05;

	}

	else {
		return 0; 
	}

 }




float calculater(float numm1, float num2, string Opreation) {

	if (Opreation == "+"    ) {
	
		return numm1 + num2; 
	}

	else if (Opreation == "-"  ) {

		return numm1 - num2; 
	}

	else if (Opreation == "*" ) {

		return numm1 * num2; 
	}

	else if (Opreation == "/")
	{ 

		return numm1 / num2; 

	}

	else {
		cout << "Must Choose Opreation..." << endl;
		return 0; 

	}
	 



}



